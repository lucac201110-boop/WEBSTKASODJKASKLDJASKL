# ============================================================
# Kubeb Client Website — Environment Configuration
# Copy this file to ".env.local" for local dev, and set these same
# values in your Vercel project's Environment Variables for production.
# ============================================================

# --- Public (safe to expose to the browser) ---
# The Discord OAuth Client ID (NOT the secret - the ID is public by design).
NEXT_PUBLIC_DISCORD_CLIENT_ID=1484196073806495834
# Must exactly match DISCORD_REDIRECT_URI in the bot project's .env, and
# a Redirect URI configured in Discord Developer Portal -> OAuth2.
NEXT_PUBLIC_DISCORD_REDIRECT_URI=https://kubebclient.com/api/auth/callback
# Public base URL of your deployed bot API (the FastAPI service).
NEXT_PUBLIC_API_URL=https://api.kubebclient.com

# --- Server-only (never exposed to the browser) ---
# Same values as above, used by the server-side route handlers that talk
# to the bot API directly.
KUBEB_API_URL=https://api.kubebclient.com
# Must match API_SECRET in the bot project's .env exactly.
KUBEB_API_SECRET=change_me_to_match_the_bot_project
